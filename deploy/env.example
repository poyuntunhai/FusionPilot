# FusionPilot production environment.
#
#   cp deploy/env.example /opt/fusionpilot/.env
#   # fill in the real values, then:
#   sudo chown fusionpilot:fusionpilot /opt/fusionpilot/.env
#   sudo chmod 600 /opt/fusionpilot/.env
#
# Both systemd units load this with EnvironmentFile=. Keeping secrets here rather
# than in the unit files means the unit files can be committed to the repository,
# and the values stay on the server.

# ---------------------------------------------------------------- database
FUSIONPILOT_DB_URL=jdbc:mysql://127.0.0.1:3306/fusionpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
FUSIONPILOT_DB_USERNAME=fusionpilot
# Required: application-mysql.yml has no default any more. Use something long and
# random, and use the same value when creating the MySQL user.
FUSIONPILOT_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# ------------------------------------------------------- auth hardening
# When true, POST /api/v1/auth/password-reset/request returns the reset token in
# the response body. That exists so the flow can be exercised without an email
# service, and it is fine on a laptop.
#
# On a public host it is an account-takeover hole: anyone can request a reset for
# any account and read the token straight out of the reply. Keep it false.
FUSIONPILOT_RETURN_RESET_TOKEN=false

# ------------------------------------------------------------ agent service
# The agent reaches the backend over loopback, never through the public origin.
JAVA_BASE_URL=http://127.0.0.1:8080
AGENT_PORT=8000

# Model credentials are deliberately absent. FusionPilot is BYOK: the user pastes
# their own token into the web UI and it travels in the X-Model-Api-Key header,
# never stored. Setting MODEL_API_KEY here would make the server pay for calls
# instead, and put a key on disk.

# ------------------------------------------------------------------ backend
# Leave this empty or unset. The backend reads SERVER__PORT, and a stray value
# overrides --server.port, which would move the port out from under nginx.
SERVER__PORT=
