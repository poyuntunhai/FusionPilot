# Copy to deploy/.deploy.env and fill in. The real file is git-ignored.
#
# With this in place, `./deploy/deploy.sh` needs no flags at all.

DEPLOY_HOST=root@YOUR.SERVER.IP
DEPLOY_DOMAIN=your-domain.com
DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519

# Optional overrides:
# DEPLOY_APP_ROOT=/opt/fusionpilot
# DEPLOY_SERVICE_USER=fusionpilot
