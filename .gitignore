# IDE
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Java
backend/target/
.m2/
.tools/

# Python
agent-service/.venv/
agent-service.venv/
agent-service/__pycache__/
agent-service/**/__pycache__/
agent-service/.pytest_cache/

# Node
web/node_modules/
web/dist/
web/.tmp/

# Compiled twin of vite.config.ts. It is emitted by `vue-tsc -b` when noEmit is missing, and
# because Vite resolves vite.config.js BEFORE vite.config.ts it silently shadows the real config.
# noEmit is set now; this is here so a stray emit can never be committed again.
web/vite.config.js

# Local configuration and generated data
.env
data/
*.sqlite
*.sqlite3
*.log
runtime*.log
# Uploaded datasets land here at runtime (runtime/datasets/<userId>/<datasetId>). Local data, not source.
/runtime/

# deploy/deploy.sh target host. Holds a real server address and key path, so it stays local.
deploy/.deploy.env

# fpx CLI state: holds an access token plus the working experiment configuration
.fpx/

# Private process notes: architecture/progress/plan logs and the product requirements doc.
# Kept on the author's machine on purpose; not part of the published repository.
memory-bank/
PRD.md

# Personal documents. These carry a real phone number and are untracked-but-sweepable:
# one `git add -A` would publish them. Kept local on purpose.
*简历*
*resume*
*.doc

# Local agent tooling state (helper memory, local skills, caches)
.workbuddy/
.agents/
